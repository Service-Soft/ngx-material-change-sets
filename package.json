{
    "name": "ngx-material-change-sets",
    "version": "0.0.0",
    "scripts": {
        "start": "ng serve ngx-material-change-sets-showcase",
        "build": "ng build ngx-material-change-sets",
        "build:watch": "ng build --watch --configuration development ngx-material-change-sets",
        "test": "ng test",
        "lint": "eslint ./ --max-warnings 0",
        "lint:fix": "eslint ./ --max-warnings 0 --fix",
        "build:prod": "npm run build && npm run copyToDist",
        "copyToDist": "npm run copyToDist:readme && npm run copyToDist:contributing && npm run copyToDist:license && npm run copyToDist:image",
        "copyToDist:readme": "ncp ./README.md ./dist/ngx-material-change-sets/README.md",
        "copyToDist:contributing": "ncp ./CONTRIBUTING.md ./dist/ngx-material-change-sets/CONTRIBUTING.md",
        "copyToDist:license": "ncp ./LICENSE.md ./dist/ngx-material-change-sets/LICENSE.md",
        "copyToDist:image": "ncp ./change-sets-component.png ./dist/ngx-material-change-sets/change-sets-component.png"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^18.0.1",
        "@angular/cdk": "^18.0.1",
        "@angular/common": "^18.0.1",
        "@angular/compiler": "^18.0.1",
        "@angular/core": "^18.0.1",
        "@angular/forms": "^18.0.1",
        "@angular/material": "^18.0.1",
        "@angular/platform-browser": "^18.0.1",
        "@angular/platform-browser-dynamic": "^18.0.1",
        "@angular/router": "^18.0.1",
        "rxjs": "~7.8.1",
        "tslib": "^2.6.2",
        "zone.js": "~0.14.6"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^18.0.2",
        "@angular/cli": "~18.0.2",
        "@angular/compiler-cli": "^18.0.1",
        "@types/jasmine": "~5.1.4",
        "eslint-config-service-soft": "^1.5.0",
        "jasmine-core": "~5.1.2",
        "karma": "~6.4.3",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "ncp": "^2.0.0",
        "ng-packagr": "^18.0.0",
        "typescript": "~5.4.5"
    }
}