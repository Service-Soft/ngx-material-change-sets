{
    "root": true,
    "extends": "eslint-config-service-soft",
    "overrides": [
        {
            "files": [
                "*.ts"
            ],
            "parserOptions": {
                "project": [
                    "tsconfig.json"
                ],
                "createDefaultProgram": true
            },
            "rules": {
                "@angular-eslint/component-selector": [
                    "warn",
                    {
                        "style": "kebab-case",
                        "type": "element",
                        "prefix": "ngx-mat-change-set"
                    }
                ]
            }
        }
    ]
}