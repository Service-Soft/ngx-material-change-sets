{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "ngx-material-change-sets": {
            "projectType": "library",
            "root": "projects/ngx-material-change-sets",
            "sourceRoot": "projects/ngx-material-change-sets/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "projects/ngx-material-change-sets/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/ngx-material-change-sets/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/ngx-material-change-sets/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "tsConfig": "projects/ngx-material-change-sets/tsconfig.spec.json",
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ]
                    }
                }
            }
        },
        "ngx-material-change-sets-showcase": {
          "projectType": "application",
          "schematics": {
            "@schematics/angular:component": {
              "style": "scss"
            }
          },
          "root": "projects/ngx-material-change-sets-showcase",
          "sourceRoot": "projects/ngx-material-change-sets-showcase/src",
          "prefix": "app",
          "architect": {
            "build": {
              "builder": "@angular-devkit/build-angular:browser",
              "options": {
                "outputPath": "dist/ngx-material-change-sets-showcase",
                "index": "projects/ngx-material-change-sets-showcase/src/index.html",
                "main": "projects/ngx-material-change-sets-showcase/src/main.ts",
                "polyfills": [
                  "zone.js"
                ],
                "tsConfig": "projects/ngx-material-change-sets-showcase/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                  "projects/ngx-material-change-sets-showcase/src/favicon.ico",
                  "projects/ngx-material-change-sets-showcase/src/assets"
                ],
                "styles": [
                  "projects/ngx-material-change-sets-showcase/src/styles.scss"
                ],
                "scripts": []
              },
              "configurations": {
                "production": {
                  "budgets": [
                    {
                      "type": "initial",
                      "maximumWarning": "500kb",
                      "maximumError": "1mb"
                    },
                    {
                      "type": "anyComponentStyle",
                      "maximumWarning": "2kb",
                      "maximumError": "4kb"
                    }
                  ],
                  "outputHashing": "all"
                },
                "development": {
                  "buildOptimizer": false,
                  "optimization": false,
                  "vendorChunk": true,
                  "extractLicenses": false,
                  "sourceMap": true,
                  "namedChunks": true
                }
              },
              "defaultConfiguration": "production"
            },
            "serve": {
              "builder": "@angular-devkit/build-angular:dev-server",
              "configurations": {
                "production": {
                  "browserTarget": "ngx-material-change-sets-showcase:build:production"
                },
                "development": {
                  "browserTarget": "ngx-material-change-sets-showcase:build:development"
                }
              },
              "defaultConfiguration": "development"
            },
            "extract-i18n": {
              "builder": "@angular-devkit/build-angular:extract-i18n",
              "options": {
                "browserTarget": "ngx-material-change-sets-showcase:build"
              }
            },
            "test": {
              "builder": "@angular-devkit/build-angular:karma",
              "options": {
                "polyfills": [
                  "zone.js",
                  "zone.js/testing"
                ],
                "tsConfig": "projects/ngx-material-change-sets-showcase/tsconfig.spec.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                  "projects/ngx-material-change-sets-showcase/src/favicon.ico",
                  "projects/ngx-material-change-sets-showcase/src/assets"
                ],
                "styles": [
                  "projects/ngx-material-change-sets-showcase/src/styles.scss"
                ],
                "scripts": []
              }
            }
          }
        }
    }
}